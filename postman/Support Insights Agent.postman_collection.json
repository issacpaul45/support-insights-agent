{
  "info": {
    "name": "Support Insights Agent",
    "description": "Local requests for the Django support-ticket agent. The OpenAI API key belongs in the server's .env file, not in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Agent - unresolved payment causes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"How many unresolved payment issues do we have, and what are the most common causes?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/agent/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "agent"
          ]
        }
      }
    },
    {
      "name": "Agent - compare unresolved categories",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Which support category has the most unresolved tickets? Compare all categories and mention ties.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/agent/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "agent"
          ]
        }
      }
    },
    {
      "name": "Agent - find recent open payment tickets",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Show me five recent open payment tickets with their titles and IDs.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/agent/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "agent"
          ]
        }
      }
    },
    {
      "name": "Agent - unresolved payment ticket IDs",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Find up to five unresolved payment tickets. Give each ticket's ID in the format #123 and include its title and status.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/agent/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "agent"
          ]
        }
      }
    }
  ]
}
